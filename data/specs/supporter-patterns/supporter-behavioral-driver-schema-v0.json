{
  "version": "v0",
  "sources": [
    "supporter_practice_toku18",
    "supporter_practice_nanbyo",
    "toku18_supporters_structure_note"
  ],
  "models": [
    {
      "model_id": "support_action_model",
      "description": "Relates vocational difficulty targets, support actions, and perceived improvement/non-improvement.",
      "dimensions": [
        "vocational_difficulty_target",
        "support_action",
        "support_action_intensity",
        "difficulty_resolution_state",
        "target_population_mix",
        "institution_type",
        "role_type"
      ],
      "primary_sources": [
        "toku18_supporters_workbook",
        "toku18_supporters_structure_note"
      ]
    },
    {
      "model_id": "support_implementation_model",
      "description": "Explains why effective support is or is not implemented through role recognition, knowledge, network participation, climate, and motivation.",
      "dimensions": [
        "role_recognition",
        "support_knowledge",
        "information_access",
        "network_participation",
        "organizational_climate",
        "regional_climate",
        "supporter_motivation",
        "implementation_feasibility",
        "implementation_barrier"
      ],
      "primary_sources": [
        "toku18_supporters_workbook",
        "toku18_supporters_structure_note",
        "nanbyo_supporters_workbook"
      ]
    }
  ],
  "canonical_dimensions": {
    "actor_context": [
      "institution_type",
      "institution_role_group",
      "professional_qualification",
      "specialty_domain",
      "region"
    ],
    "client_exposure": [
      "client_volume",
      "disability_mix",
      "severity_mix",
      "rare_disease_exposure"
    ],
