# Copy this file to .env.local and fill in values.
# Never commit .env.local (it contains secrets).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_TEMPORARY_PUBLIC_SITE_ENABLED=true
JAC_PUBLIC_ENABLED=true
JAC_ACCESS_TOKEN=

# Resend (email notifications)
RESEND_API_KEY=
APPLY_NOTIFY_EMAIL=
APPLY_FROM_EMAIL=

# JAC rate limits (raise for local testing)
JAC_COSTLY_RATE_LIMIT_PER_TOKEN_PER_DAY=500
JAC_RATE_LIMIT_PER_DAY=500
JAC_GLOBAL_RATE_LIMIT_PER_DAY=10000

# Song reactions (Cloudflare Workers)
# Set to the deployed Workers URL from workers/reactions/SETUP.md
NEXT_PUBLIC_REACTIONS_BASE_URL=https://nbl-song-reactions.nextbeinglab.workers.dev
# Set to true to enable like/play counts in the UI
NEXT_PUBLIC_REACTIONS_ENABLED=false
